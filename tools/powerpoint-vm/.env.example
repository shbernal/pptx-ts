# Copy to .env (gitignored) and set VM_PASSWORD. `pnpm ppt:vm:sync` appends the worker token.

# The Windows account, created at install time and signed in automatically at every boot.
VM_USERNAME=Docker
VM_PASSWORD=

# The keyboard layout, such as es-ES, applied when Windows is installed. Match the host's
# layout so typing through the web viewer produces the keys you press.
VM_KEYBOARD=en-US

# Resources. The defaults suit a 12-core, 16 GB host.
VM_RAM_SIZE=6G
VM_CPU_CORES=4
VM_DISK_SIZE=64G

# Where the host reaches the worker. The default is the port compose.yml publishes.
# TSPPTX_POWERPOINT_URL=http://127.0.0.1:8765

# Generated by `pnpm ppt:vm:sync` when absent. Every request to the worker carries it.
# TSPPTX_POWERPOINT_TOKEN=
