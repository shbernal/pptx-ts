{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "pptx-ts source",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		// Incremental state lives under the gitignored `.tmp/`, with a distinct file
		// per project — a shared buildinfo would thrash between the three configs.
		"incremental": true,
		"tsBuildInfoFile": ".tmp/tsconfig.tsbuildinfo"
	},
	"include": ["src/**/*.ts"]
}
