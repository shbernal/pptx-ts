{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "pptx-ts tests",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		// The few `.mjs` files under `test/` that must stay JavaScript (pages the browser lane
		// loads unbundled, and probe builds a test reads back with `toString()`) are checked
		// here at the same settings, through their JSDoc.
		"allowJs": true,
		"checkJs": true,
		"allowImportingTsExtensions": true,
		"incremental": true,
		"tsBuildInfoFile": ".tmp/tsconfig.test.tsbuildinfo",
		// Tests are held to `src/`'s strictness, `noUncheckedIndexedAccess` included: read a
		// fixture element with `at(list, i)` or `take(list, n)` from `test/helpers.ts`, which
		// fail as an assertion where an absent element would fail later as a `TypeError`.
		// The one relaxation is `noPropertyAccessFromIndexSignature`, which is house style
		// rather than correctness. Tests read attribute bags and fixture records
		// (`attrs.Target`, `opts.color`) by name, and turning it on reported over 300 such
		// reads and no bug among them.
		"noPropertyAccessFromIndexSignature": false
	},
	"include": ["test/**/*.ts", "test/**/*.mjs"],
	"exclude": [
		// Typechecked by `docs/tsconfig.json`: it loads VitePress, whose declarations only
		// compile under `skipLibCheck`, and this project keeps full lib checking.
		"test/regression/www/mermaid-fence.test.ts",
		"test/regression/www/live-fence.test.ts",
		// Run directly with `node`, like `scripts/`, so `tsconfig.scripts.json` checks them.
		"test/read/fixtures/authoring/**"
	]
}
