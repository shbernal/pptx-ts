{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "ts-pptx tests",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		// The few `.mjs` files under `test/` that must stay JavaScript (pages the browser lane
		// loads unbundled, and probe builds a test reads back with `toString()`) are checked
		// here at the same settings, through their JSDoc.
		"allowJs": true,
		"checkJs": true,
		"allowImportingTsExtensions": true,
		"incremental": true,
		"tsBuildInfoFile": ".tmp/tsconfig.test.tsbuildinfo",
		// The `.ts` tests are held to `src/`'s strictness with two exceptions.
		// `noPropertyAccessFromIndexSignature` is house style, not correctness, and tests read
		// a lot of `Record<string, …>` fixture data. `noUncheckedIndexedAccess` is off until
		// the whole suite is TypeScript. The unused-binding checks stay on: an unused binding
		// in a test is usually a stale assertion. Prefix one with `_` when it is deliberate.
		"noPropertyAccessFromIndexSignature": false,
		"noUncheckedIndexedAccess": false
	},
	"include": ["test/**/*.ts", "test/**/*.mjs"],
	"exclude": [
		// Typechecked by `docs/tsconfig.json`: it loads VitePress, whose declarations only
		// compile under `skipLibCheck`, and this project keeps full lib checking.
		"test/regression/www/mermaid-fence.test.ts",
		// Run directly with `node`, like `scripts/`, so `tsconfig.scripts.json` checks them.
		"test/read/fixtures/authoring/**"
	]
}
