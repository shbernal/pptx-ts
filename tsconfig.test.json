{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "ts-pptx tests",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		"allowJs": true,
		"checkJs": true,
		"allowImportingTsExtensions": true,
		"incremental": true,
		"tsBuildInfoFile": ".tmp/tsconfig.test.tsbuildinfo",
		// The test suite is plain ESM (`.js`/`.mjs`) run through Vitest, checked against the
		// package's public types. Null-safety is on, `exactOptionalPropertyTypes` with it, as in
		// `src/`: a test narrows a nullable read with `expectDefined`/`defined` from
		// `test/helpers.js`, which fail as an assertion rather than a later `TypeError`.
		//
		// What stays relaxed is the strictness that only pays for annotated `.ts` sources:
		// implicit `any` params/vars, index-signature property access, unused locals/params
		// (tests routinely bind for clarity or destructure a subset), unchecked index access, and
		// `unknown` catch variables (an assert-on-throw test controls what it throws).
		"noImplicitAny": false,
		"noPropertyAccessFromIndexSignature": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noUncheckedIndexedAccess": false,
		"useUnknownInCatchVariables": false
	},
	"include": ["test/**/*.js", "test/**/*.mjs"],
	// Typechecked by `docs/tsconfig.json`: it loads VitePress, whose declarations only compile
	// under `skipLibCheck`, and this project keeps full lib checking.
	"exclude": ["test/regression/www/mermaid-fence.test.js"]
}
